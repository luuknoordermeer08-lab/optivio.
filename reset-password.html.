
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Optivio | Wachtwoord herstellen</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 20px;
  background: #f3f6fb;
  font-family: Arial, sans-serif;
  color: #17243b;
}

main {
  width: 100%;
  max-width: 420px;
  background: white;
  padding: 40px;
  border-radius: 18px;
  box-shadow: 0 10px 40px #0000000d;
}

.logo {
  font-size: 28px;
  font-weight: 800;
  color: #1769e0;
}

h1 { margin-top: 35px; }

p {
  color: #718096;
  line-height: 1.6;
}

label {
  display: block;
  margin: 20px 0 8px;
  font-size: 14px;
  font-weight: bold;
}

input {
  width: 100%;
  padding: 14px;
  border: 1px solid #dce3ed;
  border-radius: 9px;
  font-size: 15px;
}

button {
  width: 100%;
  padding: 14px;
  margin-top: 22px;
  background: #1769e0;
  color: white;
  border: 0;
  border-radius: 9px;
  font-weight: bold;
  cursor: pointer;
}

button:disabled { opacity: .6; }

#message {
  font-size: 14px;
  overflow-wrap: anywhere;
}

a {
  display: inline-block;
  margin-top: 18px;
  color: #1769e0;
  text-decoration: none;
  font-size: 14px;
}
</style>
</head>

<body>

<main>
  <div class="logo">OPTIVIO.</div>

  <h1>Nieuw wachtwoord</h1>

  <p>
    Stel een nieuw wachtwoord in voor jouw beveiligde Optivio-account.
  </p>

  <form id="form">
    <label for="password">Nieuw wachtwoord</label>

    <input
      id="password"
      type="password"
      minlength="8"
      autocomplete="new-password"
      placeholder="Minimaal 8 tekens"
      required
    >

    <label for="confirmPassword">Herhaal wachtwoord</label>

    <input
      id="confirmPassword"
      type="password"
      minlength="8"
      autocomplete="new-password"
      placeholder="Herhaal je wachtwoord"
      required
    >

    <button id="saveButton" type="submit">
      Wachtwoord opslaan
    </button>
  </form>

  <p id="message" role="status" aria-live="polite"></p>

  <a href="/login.html">Terug naar inloggen</a>
</main>

<script>
const SUPABASE_URL =
  "https://vcgcowklqvfektlyzmia.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_6LEmGg5LMjgNoHHJDYmzfg_vzKf13Ry";

const message = document.getElementById("message");
const form = document.getElementById("form");
const button = document.getElementById("saveButton");

const db = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

let recoveryReady = false;

function showMessage(text, success = false) {
  message.style.color = success ? "#16834a" : "#c62828";
  message.textContent = text;
}

async function checkRecoverySession() {
  const { data, error } = await db.auth.getSession();

  if (error) {
    showMessage(error.message);
    return;
  }

  recoveryReady = !!data.session;

  if (recoveryReady) {
    showMessage("Herstelsessie actief. Je kunt een nieuw wachtwoord kiezen.", true);
  } else {
    showMessage("Geen geldige herstelsessie. Vraag een nieuwe herstelmail aan.");
    button.disabled = true;
  }
}

db.auth.onAuthStateChange((event, session) => {
  if (event === "PASSWORD_RECOVERY" && session) {
    recoveryReady = true;
    showMessage("Herstel bevestigd. Kies je nieuwe wachtwoord.", true);
    button.disabled = false;
  }
});

form.addEventListener("submit", async (event) => {
  event.preventDefault();

  const password = document.getElementById("password").value;
  const confirmation = document.getElementById("confirmPassword").value;

  if (!recoveryReady) {
    showMessage("Je hebt eerst een geldige herstelmail nodig.");
    return;
  }

  if (password !== confirmation) {
    showMessage("De wachtwoorden komen niet overeen.");
    return;
  }

  button.disabled = true;
  button.textContent = "Opslaan...";

  const { error } = await db.auth.updateUser({
    password: password
  });

  if (error) {
    showMessage(error.message);
    button.disabled = false;
    button.textContent = "Wachtwoord opslaan";
    return;
  }

  showMessage("Je wachtwoord is gewijzigd. Je kunt nu inloggen.", true);

  await db.auth.signOut();

  setTimeout(() => {
    window.location.replace("/login.html");
  }, 1800);
});

checkRecoverySession();
</script>

</body>
</html>
