
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Optivio - Nieuw wachtwoord</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
body {
  font-family: Arial, sans-serif;
  background: #f3f6fb;
  display: grid;
  place-items: center;
  min-height: 100vh;
  margin: 0;
}
main {
  background: white;
  padding: 35px;
  border-radius: 16px;
  width: min(350px, 85%);
}
input, button {
  width: 100%;
  box-sizing: border-box;
  padding: 13px;
  margin-top: 14px;
  border-radius: 8px;
}
input { border: 1px solid #ddd; }
button {
  background: #1769e0;
  color: white;
  border: 0;
  cursor: pointer;
}
#message { font-size: 14px; }
</style>
</head>
<body>
<main>
<h1>Nieuw wachtwoord</h1>
<p>Kies een nieuw wachtwoord voor jouw Optivio-account.</p>
<form id="form">
<input id="password" type="password" placeholder="Nieuw wachtwoord" minlength="8" required>
<button type="submit">Wachtwoord opslaan</button>
</form>
<p id="message"></p>
</main>
<script>
const db = window.supabase.createClient(
  "https://vcgcowklqvfektlyzmia.supabase.co",
  "sb_publishable_6LEmGg5LMjgNoHHJDYmzfg_vZKf13Ry"
);

const message = document.getElementById("message");

db.auth.onAuthStateChange((event, session) => {
  if (event === "PASSWORD_RECOVERY") {
    message.textContent = "Kies hieronder je nieuwe wachtwoord.";
  }
});

document.getElementById("form").addEventListener("submit", async (e) => {
  e.preventDefault();
  message.textContent = "Bezig...";

  const { error } = await db.auth.updateUser({
    password: document.getElementById("password").value
  });

  if (error) {
    message.textContent = error.message;
    return;
  }

  message.textContent = "Wachtwoord gewijzigd! Je kunt nu inloggen.";
});
</script>
</body>
</html>
